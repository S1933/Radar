# Personal Radar — environment variables
# Copy to .env and fill in. NEVER commit the real .env (gitignored, chmod 600).
# The .env is loaded by docker compose and by Makefile targets via --env-file.

# Database — prefer a single URL when possible; the per-field form is
# kept for symmetry with the YAML config. RADAR_DATABASE_URL wins
# when set, otherwise DSN() composes the URL from the RADAR_DB_* vars.
# RADAR_DATABASE_URL=postgres://radar:***@db:5432/radar?sslmode=disable
RADAR_DB_HOST=db
RADAR_DB_PORT=5432
RADAR_DB_USER=radar
RADAR_DB_PASSWORD=
RADAR_DB_NAME=radar

# OpenAI-compatible LLM endpoint (OpenCode Go used here)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# GitHub collector (optional but recommended)
GITHUB_TOKEN=

# Reddit (leave empty to use public RSS mode, best-effort)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X / Twitter via twscrape sidecar — authenticated session cookies.
# Export from your browser: DevTools -> Application -> Cookies -> x.com
# Equivalent to a password; rotate by re-exporting.
X_AUTH_TOKEN=
X_CT0=

# Optional: override the Python interpreter used for the X sidecar
# (defaults to /usr/bin/python3 in the Docker image)
# X_PYTHON=/usr/bin/python3
